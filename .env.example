# (선택) Web3Forms Access Key. 비워두면 코드에 들어있는 기존 사이트 키를 사용함
# 키를 새로 발급받아 바꾸고 싶을 때만 입력
VITE_WEB3FORMS_KEY=

# 링크 미리보기(og:url, og:image)에 쓰일 사이트 주소. 끝에 / 없이
# 시안 확인용으로 Vercel 주소에 올릴 땐 그 주소로 바꾸면 미리보기 이미지가 바로 보임
VITE_SITE_URL=https://www.adworld.or.kr

# (선택) hCaptcha 사이트키. 비워두면 Web3Forms 무료 플랜 공용 키를 사용함
VITE_HCAPTCHA_SITEKEY=
